PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ags
MICROSOFT_TENANT_ID=replace-with-your-directory-tenant-uuid
FRONTEND_ORIGINS=http://localhost:5173
# Render has one reverse proxy in front of the app. Keep 0 for local use.
TRUST_PROXY_HOPS=0
# Full upstream endpoint, e.g. https://your-borg-host.example/api2/borg/sales
# Leave both empty to disable sales. Never expose Borg credentials in the frontend.
BORG_SALES_URL=
# Exact Authorization header value: Bearer <token> OR the raw token, as Borg requires.
BORG_API_AUTHORIZATION=
