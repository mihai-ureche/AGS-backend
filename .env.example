PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ags
MICROSOFT_TENANT_ID=replace-with-your-directory-tenant-uuid
FRONTEND_ORIGINS=http://localhost:5173
# Render has one reverse proxy in front of the app. Keep 0 for local use.
TRUST_PROXY_HOPS=0
# Exact Borg Authorization header value: Bearer <token> OR the raw token, as Borg requires.
# Leave empty to disable Borg. Never expose Borg credentials in the frontend.
BORG_API_AUTHORIZATION=
# Optional base URL; /sales and /stock are appended. Defaults to https://borg.agritehnica.ro/api2/borg
BORG_API_URL=
